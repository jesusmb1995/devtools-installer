#!/usr/bin/env sh
# Description: Open a Drag and drop window, to drop files onto other programs.
#              Falls back to zenity file picker when dragon is not available.
#
# Dependencies: dragon (optional), kitty (optional), zenity (optional)
#
# Shell: POSIX compliant

selection=""; [ -n "$NNN_SEL" ] && selection="$NNN_SEL" || selection="$HOME/.config/nnn/.selection"

if type dragon-drag-and-drop >/dev/null 2>&1; then
    dnd="dragon-drag-and-drop"
elif type dragon-drop >/dev/null 2>&1; then
    dnd="dragon-drop"
elif [ "$TERM" = "xterm-kitty" ]; then
    dnd="kitten dnd"
elif type dragon >/dev/null 2>&1; then
    dnd="dragon"
else
    # Fallback: zenity file picker.
    # GTK4 GtkFileDialog ignores CWD, so open with --filename pointing into the
    # target directory (forces the dialog at the right place).
    dir="${2:-$PWD}"
    start="$dir"
    # Pick the first regular file in dir; GTK4 honors this initial selection.
    [ -d "$dir" ] && for f in "$dir"/*; do
        [ -f "$f" ] && start="$f" && break
    done
    # i3 for_window [title="nnn-picker"] floats + resizes + focuses.
    files=$(zenity --title="nnn-picker" --file-selection --multiple \
            --separator='|' --filename="$start" 2>/tmp/zenity-err.$$)
    rc=$?
    if [ -s /tmp/zenity-err.$$ ]; then
        printf '%s\n' "$(cat /tmp/zenity-err.$$)" >&2
    fi
    rm -f /tmp/zenity-err.$$
    if [ "$rc" -eq 0 ] && [ -n "$files" ]; then
        printf '%s' "$files" | tr '|' '\0' >> "$selection"
    fi
    exit 0
fi

resp=f
all=

add_file()
{
    printf '%s\0' "$@" >>"$selection"
}

use_all()
{
    printf "mark --all (a) [default=none]: "
    read -r resp
    if [ "$resp" = "a" ]; then
        all="--all"
    else
        all=""
    fi
}

if [ -s "$selection" ]; then
    printf "Drop file (r). Drag selection (s), Drag current directory (d) or drag current file (f) [default=f]: "
    read -r resp
else
    printf "Drop file (r). Drag current directory (d) or drag current file (f) [default=f]: "
    read -r resp
    if [ "$resp" = "s" ]; then
        resp=f
    fi
fi

if [ "$dnd" = "kitten dnd" ]; then
    if [ "$resp" = "s" ]; then
        xargs -0 $dnd 2>/dev/null <"$selection" &
    elif [ "$resp" = "d" ]; then
        $dnd "$PWD/"* 2>/dev/null &
    else
        $dnd "$1" 2>/dev/null &
    fi
else
    if [ "$resp" = "s" ]; then
        use_all
        sed -z 's|'"$PWD/"'||g' <"$selection" | xargs -0 "$dnd" "$all" 2>/dev/null &
    elif [ "$resp" = "d" ]; then
        use_all
        "$dnd" "$all" "$PWD/"* 2>/dev/null &
    elif [ "$resp" = "r" ]; then
        true >"$selection"
        "$dnd" --print-path --target 2>/dev/null | while read -r f; do
            if printf "%s" "$f" | grep -q '^\(https\?\|ftps\?\|s\?ftp\)://'; then
                if output=$(curl -fsLJOS "$f" 2>&1); then
                    filename=$(basename "$f" | sed 's/\?.*//')
                    add_file "$PWD/$filename"
                else
                    echo "Download Failed: $output"
                fi
            elif [ -e "$f" ]; then
                add_file "$f"
            fi
        done &
    elif [ -n "$1" ] && [ -e "$1" ]; then
        "$dnd" "$1" 2>/dev/null &
    fi
fi
